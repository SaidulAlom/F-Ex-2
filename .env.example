# ─────────────────────────────────────────────────────────────
# F-Ex Store — environment variables
# Copy to .env.local for development, and paste into Vercel for production.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for metadata, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── MongoDB Atlas ──────────────────────────────────────────────
# Atlas → Database → Connect → "Drivers" → copy the SRV string.
# Add /fex?retryWrites=true&w=majority and whitelist 0.0.0.0/0 for Vercel.
MONGODB_URI=

# ── NextAuth ───────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Cloudinary (product images + repair photo uploads) ─────────
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (lead notifications) ────────────────────────────────
# https://resend.com/api-keys — use a verified domain sender in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=F-Ex Store <leads@yourdomain.com>
LEAD_NOTIFY_EMAILS=owner@fexstore.in,sales@fexstore.in

# ── Google Analytics 4 (optional) ──────────────────────────────
NEXT_PUBLIC_GA_ID=

# ── Seed defaults (change before first production seed) ────────
SEED_OWNER_EMAIL=owner@fexstore.in
SEED_OWNER_PASSWORD=ChangeMe!2024
SEED_STAFF_EMAIL=basistha@fexstore.in
SEED_STAFF_PASSWORD=ChangeMe!2024

# ── Rate limiting salt ─────────────────────────────────────────
# Any random string; used to hash IPs before storing them.
RATE_LIMIT_SALT=fex-local-salt
